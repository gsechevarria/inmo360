# Copie este fichero como worker/.env (NO lo suba a Git; .gitignore ya lo excluye).
# Credencial propia y revocable del trabajador: rol inmo_worker (sin acceso a tablas; solo funciones ingest.worker_*).
# Supabase: pooler en modo SESIÓN (puerto 5432), usuario inmo_worker.<project-ref>.
INMO_WORKER_DATABASE_URL=postgresql://inmo_worker.<project-ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Nombre visible en el panel de Importaciones (por defecto pc-<nombre del equipo>)
INMO_WORKER_NAME=pc-casa

# Carpeta de datos locales: buzón de importación (inbox), capturas (captures) y almacén de fotos (media-store).
# Fuera del repositorio. En Windows, por ejemplo: C:\Users\<usuario>\Inmo360Data
INMO_DATA_DIR=C:\Users\<usuario>\Inmo360Data

# Correo de contacto que se envía en el User-Agent a las webs consultadas (opcional, recomendado)
INMO_CONTACT_EMAIL=

# Ritmo mínimo entre peticiones al mismo host (segundos) y duración de la reserva de cada trabajo
INMO_HTTP_MIN_INTERVAL=2.0
INMO_LEASE_SECONDS=120
INMO_POLL_SECONDS=10

# Fotos: desactivado por defecto. Si se activa, se guardan solo en disco local (nunca en la web).
INMO_DOWNLOAD_MEDIA=false

# Limitar los tipos de trabajo que acepta este equipo (vacío = todos), separados por comas
INMO_JOB_TYPES=

# Idealista: solo si Idealista le ha concedido acceso a su API. Sin estas claves el conector queda bloqueado.
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
