{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{2,60}$"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "sale",
        "rent"
      ]
    },
    "price": {
      "type": "object",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "sale_total",
            "rent_month",
            "rent_room_month",
            "rent_night",
            "other"
          ]
        },
        "unit_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "amount",
        "unit"
      ]
    },
    "property_type": {
      "type": "string",
      "enum": [
        "flat",
        "house",
        "penthouse",
        "duplex",
        "studio",
        "rural_house",
        "room",
        "other",
        "unknown"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "lon": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "street",
            "zone",
            "municipality",
            "unknown"
          ]
        },
        "address_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "municipality_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lat",
        "lon",
        "precision"
      ]
    },
    "built_area_m2": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "useful_area_m2": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "plot_area_m2": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "rooms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "bathrooms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "year_built": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1500,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "image_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "has_elevator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_terrace": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_parking": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_storage": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_pool": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_ac": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "floor_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "condition": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "new",
            "good",
            "to_renovate",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "energy_rating": {
      "type": [
        "string",
        "null"
      ]
    },
    "agency_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at_declared": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "withdrawal_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "withdrawn_confirmed": {
      "type": "boolean"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "agency": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source_agency_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "website": {
              "type": "string"
            },
            "discovered_via": {
              "type": "string"
            }
          },
          "required": [
            "source_agency_id",
            "name"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "extra": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "source_code",
    "external_id",
    "operation",
    "price",
    "property_type",
    "location",
    "built_area_m2",
    "useful_area_m2",
    "plot_area_m2",
    "rooms",
    "bathrooms",
    "year_built",
    "image_count",
    "has_elevator",
    "has_terrace",
    "has_parking",
    "has_storage",
    "has_pool",
    "has_ac",
    "title",
    "description",
    "floor_text",
    "condition",
    "energy_rating",
    "agency_reference",
    "published_at_declared",
    "observed_at",
    "withdrawal_evidence",
    "withdrawn_confirmed",
    "is_synthetic",
    "extra"
  ]
}
