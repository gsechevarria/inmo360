# --- Servidor (NUNCA con prefijo NEXT_PUBLIC_) ---
# Conexión del rol inmo_web (solo puede hacer SET ROLE authenticated). En Supabase, usar el pooler (puerto 6543).
DATABASE_URL=postgresql://inmo_web.<project-ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres
# supabase | local   (local SOLO para la base aislada de desarrollo; se niega en Vercel y con BD remota)
AUTH_MODE=supabase
LOCAL_AUTH_SECRET=
# --- Públicas (no secretas) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>
# Mapa base opcional (estilo MapLibre). Sin él, el mapa funciona con límites y datos propios.
NEXT_PUBLIC_BASEMAP_STYLE_URL=
NEXT_PUBLIC_BASEMAP_ORIGIN=
